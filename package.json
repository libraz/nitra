{
  "name": "@libraz/nitra",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "dev": "bun run assets && vite",
    "build": "bun run assets && tsc --noEmit && vite build",
    "assets": "bun run models && bun run wasm",
    "models": "bun run scripts/fetch-models.ts",
    "wasm": "bun run scripts/build-wasm.ts",
    "preview": "vite preview",
    "check": "biome check . && cargo fmt --manifest-path crates/heal/Cargo.toml --check",
    "lint": "biome lint . && cargo clippy --manifest-path crates/heal/Cargo.toml --release --target wasm32-unknown-unknown -- -D warnings",
    "lint:fix": "biome check --write . && cargo fmt --manifest-path crates/heal/Cargo.toml",
    "format": "biome format --write . && cargo fmt --manifest-path crates/heal/Cargo.toml",
    "typecheck": "tsc --noEmit",
    "test": "bun run wasm && vitest run",
    "test:watch": "bun run wasm && vitest"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@mediapipe/tasks-vision": "1.0.1",
    "libheif-js": "1.23.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "happy-dom": "20.14.5",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  },
  "engines": {
    "npm": "please-use-bun",
    "yarn": "please-use-bun"
  }
}
